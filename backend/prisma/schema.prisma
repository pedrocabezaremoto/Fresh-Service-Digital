datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum AppointmentStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCategory {
  MANTENIMIENTO
  REPARACION
  INSTALACION
  DIAGNOSTICO
  RECARGA
  OTRO
}

enum EquipmentType {
  VENTANA
  SPLIT
  TONELADA_1
  TONELADA_2
  TONELADA_3
  GENERAL
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  username         String?       @unique
  password         String
  firstName        String
  lastName         String
  phone            String?
  cedula           String?
  role             Role          @default(CLIENT)
  specialty        String?
  isActive         Boolean       @default(true)
  isVerified       Boolean       @default(false)
  verificationCode String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointments     Appointment[] @relation("ClientAppointments")
  assignedServices Appointment[] @relation("TechnicianAppointments")

  @@map("users")
}

model Appointment {
  id           String            @id @default(uuid())
  clientId     String
  client       User              @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   User?             @relation("TechnicianAppointments", fields: [technicianId], references: [id], onDelete: SetNull)
  status       AppointmentStatus @default(PENDING)
  scheduledAt  DateTime
  priceUsd     Float?            // precio congelado del servicio en USD (para proforma/total)
  // Ubicación del servicio (por cita: un cliente puede pedir en direcciones distintas)
  latitude     Float?
  longitude    Float?
  address      String?
  notes        String?
  serviceId    String?
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  equipment    Equipment[]

  @@index([clientId])
  @@index([technicianId])
  @@index([serviceId])
  @@map("appointments")
}

model Service {
  id            String          @id @default(uuid())
  name          String
  category      ServiceCategory
  equipmentType EquipmentType
  priceUsd      Float
  description   String?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appointments  Appointment[]

  @@unique([name, equipmentType])
  @@map("services")
}

model Equipment {
  id                 String      @id @default(uuid())
  appointmentId      String
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  brand              String // Ej: Carrier, LG, Trane
  model              String
  serialNumber       String?
  btuCapacity        Int? // Capacidad en BTU/h
  failureDescription String // Motivo del mantenimiento o reporte de falla

  @@map("equipments")
}

model SiteImage {
  id        String   @id @default(uuid())
  slot      String   @unique
  filename  String
  mimeType  String
  width     Int?
  height    Int?
  sizeBytes Int?
  updatedAt DateTime @updatedAt

  @@map("site_images")
}

// Cache de configuraciones simples (clave/valor). Usado para la tasa BCV.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// =====================================================
// CHATBOT COPITO — modelos para el chat con IA
// =====================================================

model ChatConversation {
  id              String        @id @default(uuid())
  sessionId       String        @unique
  ipHash          String
  leadId          String?
  wasConverted    Boolean       @default(false)
  messageCount    Int           @default(0)
  estimatedCostUsd Decimal      @default(0) @db.Decimal(10, 6)
  lastMessageAt   DateTime?
  startedAt       DateTime      @default(now())
  messages        ChatMessage[]

  // NUEVOS campos para chat en vivo
  operatorActive  Boolean   @default(false)
  operatorName    String?
  status          String    @default("active")  // 'active' | 'closed'
  unreadByAdmin   Int       @default(0)
  paused          Boolean   @default(false)
  blocked         Boolean   @default(false)
  imageCount      Int       @default(0)
  archived        Boolean   @default(false)

  @@index([ipHash])
  @@index([startedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id              String           @id @default(uuid())
  conversationId  String
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            String           // 'user' | 'assistant' | 'tool' | 'operator'
  content         String
  type            String           @default("text")    // 'text' | 'image'
  imageUrl        String?
  tokensIn        Int?
  tokensOut       Int?
  createdAt       DateTime         @default(now())

  @@index([conversationId])
  @@map("chat_messages")
}

model ChatLead {
  id              String    @id @default(uuid())
  name            String
  phone           String?
  email           String?
  serviceInterest String?
  message         String?
  source          String    @default("chat")
  ipHash          String
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  @@index([createdAt])
  @@map("chat_leads")
}

model ChatSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("chat_settings")
}

model CarouselImage {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  alt       String   @default("")
  position  Int      @default(0)
  active    Boolean  @default(true)
  width     Int?
  height    Int?
  sizeBytes Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carousel_images")
}
