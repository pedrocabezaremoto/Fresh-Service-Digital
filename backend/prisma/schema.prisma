datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum AppointmentStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCategory {
  MANTENIMIENTO
  REPARACION
  INSTALACION
  DIAGNOSTICO
  RECARGA
  OTRO
}

enum EquipmentType {
  VENTANA
  SPLIT
  TONELADA_1
  TONELADA_2
  TONELADA_3
  GENERAL
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  username         String?       @unique
  password         String
  firstName        String
  lastName         String
  phone            String?
  cedula           String?
  role             Role          @default(CLIENT)
  specialty        String?
  isActive         Boolean       @default(true)
  isVerified       Boolean       @default(false)
  verificationCode String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointments     Appointment[] @relation("ClientAppointments")
  assignedServices Appointment[] @relation("TechnicianAppointments")

  @@map("users")
}

model Appointment {
  id           String            @id @default(uuid())
  clientId     String
  client       User              @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   User?             @relation("TechnicianAppointments", fields: [technicianId], references: [id], onDelete: SetNull)
  status       AppointmentStatus @default(PENDING)
  scheduledAt  DateTime
  priceUsd     Float?            // precio congelado del servicio en USD (para proforma/total)
  // Ubicación del servicio (por cita: un cliente puede pedir en direcciones distintas)
  latitude     Float?
  longitude    Float?
  address      String?
  notes        String?
  serviceId    String?
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  equipment    Equipment[]

  @@index([clientId])
  @@index([technicianId])
  @@index([serviceId])
  @@map("appointments")
}

model Service {
  id            String          @id @default(uuid())
  name          String
  category      ServiceCategory
  equipmentType EquipmentType
  priceUsd      Float
  description   String?
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  appointments  Appointment[]

  @@unique([name, equipmentType])
  @@map("services")
}

model Equipment {
  id                 String      @id @default(uuid())
  appointmentId      String
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  brand              String // Ej: Carrier, LG, Trane
  model              String
  serialNumber       String?
  btuCapacity        Int? // Capacidad en BTU/h
  failureDescription String // Motivo del mantenimiento o reporte de falla

  @@map("equipments")
}

model SiteImage {
  id        String   @id @default(uuid())
  slot      String   @unique
  filename  String
  mimeType  String
  width     Int?
  height    Int?
  sizeBytes Int?
  updatedAt DateTime @updatedAt

  @@map("site_images")
}

// Cache de configuraciones simples (clave/valor). Usado para la tasa BCV.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
